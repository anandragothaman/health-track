# Copy to .env.local for local development.
# These are PUBLIC values (Project URL + anon/publishable key). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Leave both Supabase values empty to run in local demo mode (sample data stored in this browser only).

# Base path for GitHub Pages ("/<repo-name>/"). Use "/" for local dev. Set automatically in CI.
VITE_BASE_PATH=/
